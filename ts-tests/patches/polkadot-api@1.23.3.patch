diff --git a/dist/esm/tx/submit-fns.mjs b/dist/esm/tx/submit-fns.mjs
index 8c7117dfe30e6de95e6b0e35cd1c332fdd83e76a..c4e1c9b27e03f9a23f11acfa3a5a14eee7fd19ad 100644
--- a/dist/esm/tx/submit-fns.mjs
+++ b/dist/esm/tx/submit-fns.mjs
@@ -23,6 +23,19 @@ const computeState = (analized$, blocks$) => new Observable((observer) => {
       analyzed = analyzedBlocks.get(current = block.parent);
       analyzedNumber--;
     }
+    if (!analyzed) {
+      // Delayed analysis can outlive unpinned intermediate finalized headers.
+      // A retained, non-pruned block below finality is still canonical.
+      const finalizedNumber = pinnedBlocks.blocks.get(pinnedBlocks.finalized).number;
+      for (const candidate of analyzedBlocks.values()) {
+        const block = pinnedBlocks.blocks.get(candidate.hash);
+        if (candidate.found.type && block && !block.pruned && block.number <= finalizedNumber) {
+          analyzed = candidate;
+          analyzedNumber = block.number;
+          break;
+        }
+      }
+    }
     if (!analyzed) return;
     const isFinalized = analyzedNumber <= pinnedBlocks.blocks.get(pinnedBlocks.finalized).number;
     const found = analyzed.found.type;
