{
    "$schema": "https://raw.githubusercontent.com/Moonsong-Labs/moonwall/main/packages/types/config_schema.json",
    "label": "💃 MasterConfig",
    "defaultTestTimeout": 120000,
    "scriptsDir": "scripts/",
    "environments": [
        {
            "name": "dev",
            "timeout": 120000,
            "envVars": ["DEBUG_COLORS=1"],
            "testFileDir": [
                "suites/dev"
            ],
            "runScripts": [
                "generate-types.sh"
            ],
            "multiThreads": true,
            "reporters": ["basic"],
            "foundation": {
                "type": "dev",
                "launchSpec": [
                    {
                        "name": "subtensor",
                        "binPath": "../target/release/node-subtensor",
                        "options": [
                            "--one",
                            "--dev",
                            "--force-authoring",
                            "--rpc-cors=all",
                            "--no-prometheus",
                            "--no-telemetry",
                            "--reserved-only",
                            "--tmp",
                            "--sealing=manual"
                        ],
                        "disableDefaultEthProviders": true,
                        "newRpcBehaviour": true,
                        "maxStartupTimeout": 120000,
                        "connectTimeout": 30000
                    }
                ]
            }
        },
        {
            "name": "zombienet_staking",
            "timeout": 600000,
            "testFileDir": ["suites/zombienet_staking"],
            "runScripts": [
                "build-spec.sh",
                "generate-types-from-chain-spec.sh"
            ],
            "foundation": {
                "type": "zombie",
                "zombieSpec": {
                    "configPath": "./configs/zombie_single_node.json",
                    "skipBlockCheck": []
                }
            },
            "vitestArgs": {
                "bail": 1
            },
            "connections": [
                {
                    "name": "Node",
                    "type": "papi",
                    "endpoints": ["ws://127.0.0.1:9947"]
                }
            ]
        }, {
            "name": "zombienet_shield",
            "timeout": 600000,
            "envVars": ["SHIELD_RUNTIME=release"],
            "testFileDir": ["suites/zombienet_shield"],
            "runScripts": [
                "build-spec.sh",
                "generate-types-from-chain-spec.sh"
            ],
            "foundation": {
                "type": "zombie",
                "zombieSpec": {
                    "configPath": "./configs/zombie_extended.json",
                    "skipBlockCheck": []
                }
            },
            "vitestArgs": {
                "bail": 1
            },
            "connections": [
                {
                    "name": "Node",
                    "type": "papi",
                    "endpoints": ["ws://127.0.0.1:9947"],
                    "descriptor": "subtensor"
                },
                {
                    "name": "NodeFull",
                    "type": "papi",
                    "endpoints": ["ws://127.0.0.1:9950"],
                    "descriptor": "subtensor"
                }
            ]
        },
        {
            "name": "zombienet_shield_a",
            "timeout": 600000,
            "envVars": ["SHIELD_RUNTIME=release"],
            "testFileDir": ["suites/zombienet_shield"],
            "include": [
                "suites/zombienet_shield/00.01-basic.test.ts"
            ],
            "runScripts": [
                "build-spec.sh",
                "generate-types-from-chain-spec.sh"
            ],
            "foundation": {
                "type": "zombie",
                "zombieSpec": {
                    "configPath": "./configs/zombie_extended.json",
                    "skipBlockCheck": []
                }
            },
            "vitestArgs": {
                "bail": 1,
                "sequence": {
                    "concurrent": true
                },
                "maxConcurrency": 6
            },
            "connections": [
                {
                    "name": "Node",
                    "type": "papi",
                    "endpoints": ["ws://127.0.0.1:9947"],
                    "descriptor": "subtensor"
