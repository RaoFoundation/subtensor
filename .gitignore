# Generated by Cargo
# will have compiled files and executables
**/target/
# These are backup files generated by rustfmt
**/*.rs.bk

**/*.lock
!evm-tests/yarn.lock
!website/yarn.lock
!sdk/python/uv.lock

*.ipynb

# Generated by code coverage
*.profraw
*.profdata

.DS_Store

# The cache for docker container dependency
.cargo

# The cache for chain data in container
.local

# direnv files
.envrc
.direnv

# Vim (BTW™)
*.swp
*.swo
tmp/

# Resulting chainspec files from localnet
specs/*.json

# Git merge/rebase artifacts
*.orig

# VSCode configuration
.vscode

# IntelliJ IDEA configuration
.idea

# Runtime upgrade snapshot
bt.snap

# localnet spec
scripts/specs/local.json

# Node modules
node_modules

# Python bytecode cache (from .github/ai-review/*.py)
__pycache__/
*.py[cod]

# Python dev environments and tooling caches
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
py-sp-core/dist/
sdk/python/dist/

# Local dev logs
*.log

# Claude Code configuration (skills are checked in; everything else is ignored)
# .claude/skills is a symlink to .agents/skills (single source of truth);
# the trailing-slash-free negation is required to re-include the symlink.
.claude/*
!.claude/skills
.vercel

# Secrets and local env files (keep .env.example committable if added)
.env
.env.*
!.env.example

# First-signer working files (see .github/scripts/deploy/README.md)
.github/scripts/deploy/subtensor.wasm
.github/scripts/deploy/subtensor-digest.json
.github/scripts/deploy/proxy_proxy_blob.hex
.github/scripts/deploy/pending-release.json
.github/scripts/deploy/deployment-multisig-proposal.hex
