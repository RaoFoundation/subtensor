class Runtime:
    def __init__(
        self,
        metadata_bytes: bytes,
        spec_version: int,
        transaction_version: int,
        ss58_format: int = 42,
    ) -> None: ...
    @property
    def spec_version(self) -> int: ...
    @property
    def transaction_version(self) -> int: ...
    @property
    def ss58_format(self) -> int: ...
    @property
    def is_v15(self) -> bool: ...
    @property
    def extrinsic_version(self) -> int: ...
    def decode(self, type_string: str, data: bytes, strict: bool = True) -> Any: ...
    def batch_decode(self, type_strings: Sequence[str], datas: Sequence[bytes]) -> list[Any]: ...
    def encode(self, type_string: str, value: Any) -> bytes: ...
    def type_id_of(self, name: str) -> Optional[int]: ...
    def registry_json(self) -> str: ...
    def type_name_of(self, id: int) -> Optional[str]: ...
    def compose_call(self, module: str, function: str, params: Any) -> bytes: ...
    def decode_call(self, data: bytes) -> dict[str, Any]: ...
    def storage_entry(self, pallet: str, storage_function: str) -> StorageEntry: ...
    def storage_prefix(self, pallet: str, storage_function: str) -> bytes: ...
    def storage_key(self, pallet: str, storage_function: str, params: Sequence[Any]) -> bytes: ...
    def storage_key_batch(
        self, pallet: str, storage_function: str, params_list: Sequence[Sequence[Any]]
    ) -> list[bytes]: ...
    def decode_storage_key_params(
        self, pallet: str, storage_function: str, key: bytes, fixed: int = 0
    ) -> list[Any]: ...
    def decode_map_pairs(
        self,
        pallet: str,
        storage_function: str,
        raw_keys: Sequence[bytes],
        raw_values: Sequence[bytes],
        fixed: int = 0,
    ) -> list[tuple[Any, Any]]: ...
    def decode_map_changes(
        self,
        pallet: str,
        storage_function: str,
        changes: Sequence[tuple[str, Optional[str]]],
        fixed: int = 0,
    ) -> list[tuple[Any, Any]]: ...
    def constant(self, module: str, name: str) -> Any: ...
    def module_error(self, module_index: int, error_index: int) -> tuple[str, list[str]]: ...
    def signed_extension_identifiers(self) -> list[str]: ...
    def encode_era(self, era: Any) -> bytes: ...
    def signature_payload_parts(
        self,
        *,
        era: Any,
        nonce: int,
        tip: int,
        tip_asset_id: Optional[int],
        genesis_hash: bytes,
        era_block_hash: bytes,
        metadata_hash: Optional[bytes] = None,
    ) -> tuple[bytes, bytes]: ...
    def signature_payload(
        self,
        call_data: bytes,
        *,
        era: Any,
        nonce: int,
        tip: int,
        tip_asset_id: Optional[int],
        genesis_hash: bytes,
        era_block_hash: bytes,
        metadata_hash: Optional[bytes] = None,
    ) -> bytes: ...
    def encode_signed_extrinsic(
        self,
        call_data: bytes,
        *,
        public_key: bytes,
        signature: bytes,
        signature_version: int,
        era: Any,
        nonce: int,
        tip: int,
        tip_asset_id: Optional[int],
        metadata_hash_enabled: bool = False,
    ) -> tuple[bytes, bytes]: ...
    def decode_extrinsic(self, data: bytes, strict: bool = True) -> dict[str, Any]: ...
    def runtime_api_map(self) -> dict[str, Any]: ...
    def metadata_ir(self) -> dict[str, Any]: ...

