"""Public PyO3 API, matching src/{keys,runtime,digest,timelock,pow,ledger}.rs.

SCALE values depend on runtime metadata, so their payloads remain Any.
Maturin includes this stub and a py.typed marker in the published wheel.
"""

from typing import Any, Optional, Sequence

__core_version__: str
CRYPTO_ED25519: int
CRYPTO_SR25519: int

class KeyfileError(Exception): ...
class WrongPasswordError(KeyfileError): ...
class LedgerError(Exception): ...

class Keypair:
    def __init__(
        self,
        ss58_address: Optional[str] = None,
        public_key: Optional[bytes] = None,
        crypto_type: int = 1,
        ss58_format: int = 42,
    ) -> None: ...
    @staticmethod
    def from_mnemonic(
        mnemonic: str, crypto_type: int = 1, password: Optional[str] = None
    ) -> Keypair: ...
    @staticmethod
    def create_from_mnemonic(
        mnemonic: str, crypto_type: int = 1, password: Optional[str] = None
    ) -> Keypair: ...
    @staticmethod
    def from_seed(seed: bytes, crypto_type: int = 1) -> Keypair: ...
    @staticmethod
    def create_from_seed(seed: bytes, crypto_type: int = 1) -> Keypair: ...
    @staticmethod
    def from_uri(uri: str, crypto_type: int = 1) -> Keypair: ...
    @staticmethod
    def create_from_uri(uri: str, crypto_type: int = 1) -> Keypair: ...
    @staticmethod
    def create_from_private_key(private_key: str, crypto_type: int = 1) -> Keypair: ...
    @staticmethod
    def generate_mnemonic(n_words: int = 12) -> str: ...
    @staticmethod
    def create_from_encrypted_json(json_data: str, passphrase: str) -> Keypair: ...
    @property
    def crypto_type(self) -> int: ...
    @property
    def public_key(self) -> bytes: ...
    @property
    def ss58_address(self) -> str: ...
    @property
    def ss58_format(self) -> int: ...
    def sign(self, message: str | bytes) -> bytes: ...
    def verify(self, message: bytes, signature: bytes) -> bool: ...
    def encrypt(self, message: bytes) -> bytes: ...
    def decrypt(self, ciphertext: bytes) -> bytes: ...
    @staticmethod
    def encrypt_for(ss58_address: str, message: bytes, crypto_type: int = 0) -> bytes: ...

def verify(message: bytes, signature: bytes, ss58_address: str, crypto_type: int = 1) -> bool: ...
def ss58_decode(ss58_address: str) -> bytes: ...
def ss58_encode(public_key: bytes, ss58_format: int = 42) -> str: ...
def serialized_keypair_to_keyfile_data(keypair: Keypair) -> bytes: ...
def deserialize_keypair_from_keyfile_data(keyfile_data: bytes) -> Keypair: ...
def encrypt_keyfile_data(keyfile_data: bytes, password: str) -> bytes: ...
def decrypt_keyfile_data(keyfile_data: bytes, password: Optional[str] = None) -> bytes: ...
def keyfile_data_is_encrypted(keyfile_data: bytes) -> bool: ...
def keyfile_data_is_encrypted_nacl(keyfile_data: bytes) -> bool: ...
def keyfile_data_is_encrypted_ansible(keyfile_data: bytes) -> bool: ...
def keyfile_data_is_encrypted_legacy(keyfile_data: bytes) -> bool: ...
def keyfile_data_encryption_method(keyfile_data: bytes) -> str: ...
def get_password_from_environment(env_var_name: str) -> Optional[str]: ...
def save_password_to_environment(env_var_name: str, password: str) -> str: ...
def era_birth(period: int, current: int) -> int: ...
